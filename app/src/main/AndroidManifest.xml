<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JardulliCalculadora"
        tools:targetApi="31">

        <!-- ADICIONE ESTE PROVIDER -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.jardullicalculadora.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".AvancoRatio"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".DadosJardulli"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RelatorioActivity2"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RelatorioFinalActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PesosTraseirosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".LastroLiquidoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PesoFrontalActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AvancoRatioActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RodadosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".TratorOperacaoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>