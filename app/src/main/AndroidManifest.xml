<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Necessária para salvar PDF em Downloads em Android < 10 (API 28).
         Em API 29+ usamos Scoped Storage e a permissão é ignorada. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/pdf" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JardulliCalculadora"
        tools:targetApi="31">

        <!-- ADICIONE ESTE PROVIDER -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".RelatorioFinalActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".LastroLiquidoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PesoFrontalActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AvancoRatioActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RodadosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".TratorOperacaoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".HistoricoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".SuporteActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AuthActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RecuperarSenhaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PerfilActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".PlanosActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>