<?xml version="1.0" encoding="utf-8"?><!--
   Regras de extração de dados (Android 12+). Excluímos os tokens Supabase
   tanto do backup em nuvem quanto da transferência device-to-device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="jardulli_plano_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jardulli_plano_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
