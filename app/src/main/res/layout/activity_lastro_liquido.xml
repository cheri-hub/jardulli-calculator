<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/spinner_background"
    android:fillViewport="true"
    tools:context=".LastroLiquidoActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Header Section -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Logo/Ícone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚜"
                android:textSize="32sp"
                android:layout_marginBottom="8dp" />

            <!-- Título -->
            <TextView
                android:id="@+id/textTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="JARDULLI AGRO MÁQUINAS\nCALCULADORA DE LASTRO"
                android:textColor="#2E7D32"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

            <!-- Subtítulo -->
            <TextView
                android:id="@+id/textSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Lastro Líquido"
                android:textColor="#666666"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Form Section - Lastro Dianteiro -->
        <LinearLayout
            android:id="@+id/formDianteiroLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_background"
            android:elevation="2dp"
            app:layout_constraintTop_toBottomOf="@+id/headerLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lastro Dianteiro"
                android:textColor="#2E7D32"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Rodado Dianteiro Selecionado -->
            <TextView
                android:id="@+id/textRodadoDianteiroSelecionado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rodado Dianteiro Selecionado"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />



            <!-- Multiplicador Dianteiro -->
            <TextView
                android:id="@+id/textMultiplicadorDianteiroLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Multiplicador Dianteiro"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerMultiplicadorDianteiro"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/spinner_background_modern"
                android:popupBackground="@color/gray_100"
                android:theme="@style/SpinnerTextBlack"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#333333"
                android:layout_marginBottom="16dp" />

            <!-- Resultado Dianteiro -->
            <TextView
                android:id="@+id/textResultadoDianteiroLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resultado Dianteiro"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textResultadoDianteiro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_background"
                android:padding="16dp"
                android:text="0 kg"
                android:textColor="#2E7D32"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Form Section - Lastro Traseiro -->
        <LinearLayout
            android:id="@+id/formTraseiroLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_background"
            android:elevation="2dp"
            app:layout_constraintTop_toBottomOf="@+id/formDianteiroLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lastro Traseiro"
                android:textColor="#2E7D32"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Rodado Traseiro Selecionado -->
            <TextView
                android:id="@+id/textRodadoTraseiroSelecionado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rodado Traseiro Selecionado"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />


            <!-- Multiplicador Traseiro -->
            <TextView
                android:id="@+id/textMultiplicadorTraseiroLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LASTRO LIQUIDO"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerMultiplicadorTraseiro"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/spinner_background_modern"
                android:popupBackground="@color/gray_100"
                android:theme="@style/SpinnerTextBlack"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#333333"
                android:layout_marginBottom="16dp" />

            <!-- Resultado Traseiro -->
            <TextView
                android:id="@+id/textResultadoTraseiroLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resultado Traseiro"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textResultadoTraseiro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_background"
                android:padding="16dp"
                android:text="0 kg"
                android:textColor="#2E7D32"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Botões Section -->
        <LinearLayout
            android:id="@+id/buttonsLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/formTraseiroLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:padding="8dp">

            <Button
                android:id="@+id/btnVoltar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_background_outline"
                android:text="Voltar"
                android:textColor="#2E7D32"
                android:textSize="16sp"
                android:textStyle="bold"
                style="?android:attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/btnAvancar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_background_primary"
                android:text="Avançar"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Espaço no final para melhor rolagem -->
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintTop_toBottomOf="@+id/buttonsLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>