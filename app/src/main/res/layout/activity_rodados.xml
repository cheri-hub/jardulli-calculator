<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/spinner_background"
    android:fillViewport="true"
    tools:context=".RodadosActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Header Section -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Logo/Ícone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚜"
                android:textSize="32sp"
                android:layout_marginBottom="8dp" />

            <!-- Título -->
            <TextView
                android:id="@+id/textTituloRodados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="JARDULLI AGRO MÁQUINAS\nCALCULADORA DE LASTRO"
                android:textColor="#2E7D32"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

            <!-- Subtítulo -->
            <TextView
                android:id="@+id/textSubtitulo4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Rodados"
                android:textColor="#666666"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Form Section - Rodados Dianteiros -->
        <LinearLayout
            android:id="@+id/formDianteiroLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_background"
            android:elevation="2dp"
            app:layout_constraintTop_toBottomOf="@+id/headerLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rodados Dianteiros"
                android:textColor="#2E7D32"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Grupo Dianteiro -->
            <TextView
                android:id="@+id/textGrupoDianteiro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grupo Dianteiro"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />



            <!-- Rodado Dianteiro -->
            <TextView
                android:id="@+id/textRodadoLabelDianteiro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rodado Dianteiro"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerRodadoDianteiro"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/spinner_background_modern"
                android:popupBackground="@color/gray_100"
                android:theme="@style/SpinnerTextBlack"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#333333"
                android:layout_marginBottom="16dp" />

            <!-- Eixo Dianteiro -->
            <TextView
                android:id="@+id/textEixoLabelDianteiro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eixo Dianteiro"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerEixoDianteiro"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/spinner_background_modern"
                android:popupBackground="@color/gray_100"
                android:theme="@style/SpinnerTextBlack"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Form Section - Rodados Traseiros -->
        <LinearLayout
            android:id="@+id/formTraseiroLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_background"
            android:elevation="2dp"
            app:layout_constraintTop_toBottomOf="@+id/formDianteiroLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rodados Traseiros"
                android:textColor="#2E7D32"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Grupo Traseiro -->
            <TextView
                android:id="@+id/textGrupoTraseiro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grupo Traseiro"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />



            <!-- Rodado Traseiro -->
            <TextView
                android:id="@+id/textRodadoLabelTraseiro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rodado Traseiro"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerRodadoTraseiro"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/spinner_background_modern"
                android:popupBackground="@color/gray_100"
                android:theme="@style/SpinnerTextBlack"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#333333"
                android:layout_marginBottom="16dp" />

            <!-- Eixo Traseiro -->
            <TextView
                android:id="@+id/textEixoLabelTraseiro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eixo Traseiro"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerEixoTraseiro"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/spinner_background_modern"
                android:popupBackground="@color/gray_100"
                android:theme="@style/SpinnerTextBlack"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Botões Section -->
        <LinearLayout
            android:id="@+id/buttonsLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/formTraseiroLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:padding="8dp">

            <Button
                android:id="@+id/btnVoltar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_background_outline"
                android:text="Voltar"
                android:textColor="#2E7D32"
                android:textSize="16sp"
                android:textStyle="bold"
                style="?android:attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/btnAvancar"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_background_primary"
                android:text="Avançar"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Espaço no final para melhor rolagem -->
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintTop_toBottomOf="@+id/buttonsLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>