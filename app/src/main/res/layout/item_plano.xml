<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:elevation="4dp"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Nome do plano + badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/txtNomePlano"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PROFISSIONAL"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />

        <TextView
            android:id="@+id/txtBadgeAtual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ATUAL"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/badge_plano"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Preço -->
    <TextView
        android:id="@+id/txtPreco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="R$ 25/mês"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="8dp" />

    <!-- Features -->
    <TextView
        android:id="@+id/txtFeatures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✅ Balanços ilimitados\n✅ Relatório PDF\n✅ Histórico\n✅ Suporte WhatsApp"
        android:textSize="13sp"
        android:textColor="#757575"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Botão Assinar -->
    <Button
        android:id="@+id/btnAssinar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#43A047"
        android:text="Assinar"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
